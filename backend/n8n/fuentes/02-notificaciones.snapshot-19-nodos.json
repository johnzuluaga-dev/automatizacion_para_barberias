        "id": "3297ad8b-4379-4d9b-b16a-b36cabfb47e8",
        "name": "Buscar citas confirmadas",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.5,
        "position": [
          464,
          864
        ],
        "executeOnce": true,
        "credentials": {
          "googleApi": {
