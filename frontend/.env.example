# Copia este archivo como .env y completa los valores. Nunca subas .env.

# n8n (opcional). Con VITE_N8N_ENABLED=true se avisa al webhook de cada reserva.
VITE_N8N_WEBHOOK_URL=
VITE_N8N_ENABLED=false
# Webhook de n8n que cancela una cita desde el enlace del mensaje (sin sesión).
VITE_N8N_CANCEL_WEBHOOK_URL=

# Firebase (Configuración del proyecto → Tus apps → Web). No son secretos, pero van en .env.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
