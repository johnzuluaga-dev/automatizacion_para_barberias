# Copia este archivo como .env y completa los valores. Nunca subas .env.

# Supabase (Project Settings → API). Usa SOLO la clave pública (publishable/anon).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# n8n (opcional). Con VITE_N8N_ENABLED=true se avisa al webhook de cada reserva.
VITE_N8N_WEBHOOK_URL=
VITE_N8N_ENABLED=false

# Acceso con código por SMS. Requiere configurar un proveedor (p. ej. Twilio) en Supabase.
VITE_AUTH_SMS_ENABLED=false
